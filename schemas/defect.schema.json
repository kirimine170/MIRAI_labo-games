{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kirimine170/MIRAI_labo-games/main/schemas/defect.schema.json",
  "title": "HackSick Academy defect manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "defect_id",
    "game_id",
    "title",
    "lifecycle",
    "target_learners",
    "learning",
    "versions",
    "fault",
    "reproduction",
    "repair",
    "tests",
    "hints"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "defect_id": {"type": "string", "pattern": "^[0-9]{2}_[0-9]{2}-D[0-9]{2}$"},
    "game_id": {"type": "string", "pattern": "^[0-9]{2}_[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["planned", "implemented", "validated", "retired"]},
    "target_learners": {"$ref": "#/$defs/target_learners"},
    "learning": {"$ref": "#/$defs/learning"},
    "versions": {"$ref": "#/$defs/versions"},
    "fault": {"$ref": "#/$defs/fault"},
    "reproduction": {"$ref": "#/$defs/reproduction"},
    "repair": {"$ref": "#/$defs/repair"},
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/defect_test"}
    },
    "hints": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/hint"}
    }
  },
  "$defs": {
    "target_learners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grades", "support", "estimated_minutes"],
      "properties": {
        "grades": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["\u5c0f3", "\u5c0f4", "\u5c0f5", "\u5c0f6", "\u4e2d1", "\u4e2d2", "\u4e2d3"]}
        },
        "support": {"enum": ["independent", "pair", "facilitated"]},
        "estimated_minutes": {"type": "integer", "minimum": 10, "maximum": 45}
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_concept", "secondary_concepts", "objective"],
      "properties": {
        "primary_concept": {"$ref": "#/$defs/concept"},
        "secondary_concepts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/concept"}
        },
        "objective": {"type": "string", "minLength": 1}
      }
    },
    "complete_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_path", "behavior"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "source_path": {"$ref": "#/$defs/repository_path"},
        "behavior": {"type": "string", "minLength": 1}
      }
    },
    "defective_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_label", "delivery", "base_version", "patch_targets"],
      "properties": {
        "version_label": {"type": "string", "pattern": "^defect-[a-z0-9-]+$"},
        "delivery": {"enum": ["planned_patch", "patch", "source_tree"]},
        "base_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "patch_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repository_path"}
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "defective"],
      "properties": {
        "complete": {"$ref": "#/$defs/complete_version"},
        "defective": {"$ref": "#/$defs/defective_version"}
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "symptom", "expected_behavior", "root_cause", "trigger"],
      "properties": {
        "category": {
          "enum": [
            "boundary-condition",
            "missing-condition",
            "state-management",
            "feedback-sync",
            "event-order",
            "calculation"
          ]
        },
        "symptom": {"type": "string", "minLength": 1},
        "expected_behavior": {"type": "string", "minLength": 1},
        "root_cause": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1}
      }
    },
    "reproduction_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "action", "expected_observation"],
      "properties": {
        "step": {"type": "integer", "minimum": 1},
        "action": {"type": "string", "minLength": 1},
        "expected_observation": {"type": "string", "minLength": 1}
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preconditions", "steps"],
      "properties": {
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/reproduction_step"}
        }
      }
    },
    "edit_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "anchor"],
      "properties": {
        "path": {"$ref": "#/$defs/repository_path"},
        "anchor": {"type": "string", "minLength": 1}
      }
    },
    "minimal_fix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "edit_targets", "constraints"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "edit_targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/edit_target"}
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "acceptance_criteria"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimal_fix", "acceptable_alternatives", "rejected_shortcuts"],
      "properties": {
        "minimal_fix": {"$ref": "#/$defs/minimal_fix"},
        "acceptable_alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/alternative"}
        },
        "rejected_shortcuts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "defect_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "kind",
        "setup",
        "actions",
        "expected_complete",
        "expected_defective",
        "automatable"
      ],
      "properties": {
        "test_id": {"type": "string", "pattern": "^[0-9]{2}_[0-9]{2}-D[0-9]{2}-T[0-9]{2}$"},
        "kind": {"enum": ["symptom", "boundary", "regression", "no-defect"]},
        "setup": {"type": "string", "minLength": 1},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_complete": {"type": "string", "minLength": 1},
        "expected_defective": {"type": "string", "minLength": 1},
        "automatable": {"type": "boolean"}
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "focus", "prompt"],
      "properties": {
        "level": {"type": "integer", "minimum": 1, "maximum": 5},
        "focus": {"enum": ["observation", "reproduction", "variable", "control-flow", "repair"]},
        "prompt": {"type": "string", "minLength": 1}
      }
    },
    "repository_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.\\-/]+$"
    }
  }
}
