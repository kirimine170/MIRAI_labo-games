{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kirimine170/MIRAI_labo-games/main/schemas/game.schema.json",
  "title": "HackSick Academy game manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "game_id",
    "slug",
    "title",
    "lifecycle",
    "summary",
    "source",
    "target_learners",
    "learning",
    "gameplay",
    "versions",
    "tests"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "game_id": {"type": "string", "pattern": "^[0-9]{2}_[0-9]{2}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "lifecycle": {"enum": ["prototype", "complete", "archived"]},
    "summary": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "target_learners": {"$ref": "#/$defs/target_learners"},
    "learning": {"$ref": "#/$defs/learning"},
    "gameplay": {"$ref": "#/$defs/gameplay"},
    "versions": {"$ref": "#/$defs/versions"},
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/game_test"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete_path", "toolchain", "configuration", "files"],
      "properties": {
        "complete_path": {"$ref": "#/$defs/repository_path"},
        "toolchain": {"type": "string", "minLength": 1},
        "configuration": {"$ref": "#/$defs/repository_path"},
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[^/].*\\.gs$"}
        }
      }
    },
    "target_learners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grades", "support", "assumed_skills"],
      "properties": {
        "grades": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["\u5c0f3", "\u5c0f4", "\u5c0f5", "\u5c0f6", "\u4e2d1", "\u4e2d2", "\u4e2d3"]}
        },
        "support": {"enum": ["independent", "pair", "facilitated"]},
        "assumed_skills": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_concepts", "transfer_family", "learning_goals"],
      "properties": {
        "primary_concepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/concept"}
        },
        "transfer_family": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "learning_goals": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default", "unit", "meaning"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "default": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genre",
        "expected_duration_minutes",
        "states",
        "input_actions",
        "clear_condition",
        "failure_condition",
        "settings"
      ],
      "properties": {
        "genre": {"type": "string", "minLength": 1},
        "expected_duration_minutes": {"type": "integer", "minimum": 1, "maximum": 45},
        "states": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "input_actions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "clear_condition": {"type": "string", "minLength": 1},
        "failure_condition": {"type": "string", "minLength": 1},
        "settings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/setting"}
        }
      }
    },
    "complete_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "source_path"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"enum": ["verified", "needs_qa"]},
        "source_path": {"$ref": "#/$defs/repository_path"}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "defect_manifests"],
      "properties": {
        "complete": {"$ref": "#/$defs/complete_version"},
        "defect_manifests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repository_path"}
        }
      }
    },
    "game_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "kind", "scenario", "expected"],
      "properties": {
        "test_id": {"type": "string", "pattern": "^[0-9]{2}_[0-9]{2}-C[0-9]{2}$"},
        "kind": {"enum": ["normal", "boundary", "state-transition", "regression"]},
        "scenario": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1}
      }
    },
    "repository_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.\\-/]+$"
    }
  }
}
